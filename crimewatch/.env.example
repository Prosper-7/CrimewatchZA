# Copy this file to .env and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push (Phase 3 — alerts). Brooklyn generates the VAPID key pair
# (e.g. via `npx web-push generate-vapid-keys`) and shares the PUBLIC key
# only — the private key stays server-side as a Supabase Edge Function secret.
VITE_VAPID_PUBLIC_KEY=
